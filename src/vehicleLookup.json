  "autosuggest": {
    "field": "registrationNumber",
    "placeholder": "Start typing a registration number, e.g. KDQ089K",
    "helperText": "Type at least 1 character to search existing vehicles",
    "emptyText": "No vehicle found for that registration",
    "minChars": 1,
    "maxSuggestions": 12,
    "debounceMs": 150,
    "matchMode": "contains",
    "caseSensitive": false,
    "normalize": {
      "uppercase": true,
      "stripSpaces": true,
      "stripHyphens": true
    },
    "searchFields": [
      "vehicle.registrationNumber",
      "vehicle.make",
      "vehicle.model",
      "client.name"
    ],
    "suggestionTemplate": {
      "primary": "{vehicle.registrationNumber}",
      "secondary": "{vehicle.make} {vehicle.model}",
      "tertiary": "{client.name} · {intermediary.name}",
      "trailing": "{vehicle.yearOfManufacture}"
    },
    "keyboard": {
      "ArrowDown": "next",
      "ArrowUp": "previous",
      "Enter": "select",
      "Escape": "close"
    }
  },
  "onSelect": {
    "action": "autofill",
    "fills": [
      {
        "target": "make",
        "from": "record.vehicle.make"
      },
      {
        "target": "model",
        "from": "record.vehicle.model"
      },
      {
        "target": "yearOfManufacture",
        "from": "record.vehicle.yearOfManufacture"
      },
      {
        "target": "intermediaryName",
        "from": "record.intermediary.name"
      },
      {
        "target": "intermediaryCode",
        "from": "record.intermediary.code"
      },
      {
        "target": "insuredName",
        "from": "record.client.name"
      },
      {
        "target": "insuredIdNumber",
        "from": "record.client.idNumber"
      },
      {
        "target": "intermediaryPhone",
        "from": "record.intermediary.phone"
      },
      {
        "target": "intermediaryEmail",
        "from": "record.intermediary.email"
      }
    ],
    "lockFilledFields": true,
    "lockedFieldStyle": {
      "readOnly": true,
      "tabIndex": -1,
      "background": "#f1f5f9",
      "borderColor": "#e2e8f0",
      "textColor": "#64748b",
      "cursor": "not-allowed",
      "badge": null,
      "badgeNote": "No badge or lock glyph - the grey treatment alone signals the locked state."
    },
    "detailPanel": {
      "title": "Policy record",
      "subtitle": "{quoteRef}",
      "badge": "{sourceOrigin}",
      "rows": [
        {
          "label": "Engine CC",
          "from": "record.vehicle.engineCc"
        },
        {
          "label": "Engine No.",
          "from": "record.vehicle.engineNumber"
        },
        {
          "label": "Chassis No.",
          "from": "record.vehicle.chassisNumber"
        },
        {
          "label": "Class",
          "from": "record.vehicle.motorClass"
        },
        {
          "label": "Sum Insured",
          "from": "record.vehicle.sumInsured",
          "format": "KES #,##0"
        },
        {
          "label": "Insured Phone",
          "from": "record.client.phone"
        },
        {
          "label": "Insured Email",
          "from": "record.client.email"
        }
      ]
    },
    "unlock": {
      "trigger": "clearRegistration",
      "label": "Clear",
      "behavior": "clears every auto-filled field and returns them to editable"
    },
    "sideEffects": [
      {
        "target": "partyType",
        "value": "intermediary",
        "reason": "Defaults the party panel to Intermediary; the toggle stays enabled so the user can view the locked insured details, which come from insurance_data.client on the same draft quote."
      }
    ]
  },
