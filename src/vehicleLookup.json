{
  "schemaVersion": "fnol.vehicle-lookup/v3",
  "generatedAt": "2026-08-20",
  "source": {
    "engine": "postgres",
    "database": "web_dev",
    "server": "db:5432",
    "primaryTable": "draftquote",
    "jsonColumn": "insurance_data",
    "join": {
      "table": "user",
      "on": "draftquote.draft_quote_user_id = user.id",
      "type": "inner"
    },
    "note": "Hardcoded snapshot of live rows. Swap `records` for GET /api/vehicles/search?q= returning the same shape and nothing else changes.",
    "namingNote": "Live objects are `draftquote` and `insurance_data` (the spec wrote draftqoute / insuarance_data)."
  },
  "normalization": {
    "note": "The raw jsonb carries several keys for the same fact, written by different intake paths. Each record stores one canonical camelCase key per fact; aliases collapse in the order listed and the duplicates are dropped, so no value repeats anywhere in a record.",
    "collapsedAliases": {
      "vehicle.registrationNumber": [
        "registration_number",
        "registration",
        "reg_no"
      ],
      "vehicle.yearOfManufacture": [
        "year_of_manufacture",
        "year"
      ],
      "vehicle.engineCc": [
        "cc",
        "engine_capacity"
      ],
      "vehicle.engineNumber": [
        "engine_number",
        "engine_no"
      ],
      "vehicle.chassisNumber": [
        "chassis_number",
        "chassis_no",
        "chassis"
      ],
      "vehicle.seatingCapacity": [
        "seating_capacity",
        "number_of_passengers",
        "licensed_to_carry"
      ],
      "vehicle.sumInsured": [
        "sum_insured",
        "value"
      ],
      "client.idNumber": [
        "id_number"
      ]
    },
    "droppedFromRawJson": {
      "vehicle": [
        "vehicle_usage"
      ],
      "client": [
        "type",
        "kra_pin",
        "pin",
        "date_of_birth",
        "city",
        "address",
        "postal_address",
        "huduma_number",
        "saz_assist_activation_number"
      ],
      "reason": "Not consumed by the FNOL form. Re-add to the SELECT if a downstream step needs them."
    },
    "emptyKeysOmitted": true
  },
  "shapes": {
    "record": {
      "quoteRef": {
        "type": "string",
        "dbPath": "draftquote.draft_quote_ref"
      },
      "sourceOrigin": {
        "type": "string",
        "enum": [
          "on-portal",
          "off-portal"
        ],
        "derivation": "off-portal when insurance_data ? 'renewal' (row seeded from an uploaded renewal-notice batch - see renewal_notices.source_file_name / upload_batch_id); otherwise on-portal.",
        "note": "Derived, not stored: draftquote has no channel column."
      }
    },
    "vehicle": {
      "path": "draftquote.insurance_data.vehicle",
      "keys": {
        "registrationNumber": {
          "type": "string",
          "formLabel": "Registration Number"
        },
        "make": {
          "type": "string",
          "formLabel": "Make"
        },
        "model": {
          "type": "string",
          "formLabel": "Model"
        },
        "yearOfManufacture": {
          "type": "number",
          "formLabel": "Year of Manufacture"
        },
        "bodyType": {
          "type": "string",
          "note": "either a Premia code ('001', '004') or a label ('STATION WAGON')"
        },
        "motorClass": {
          "type": "string",
          "enumSeen": [
            "private",
            "commercial"
          ]
        },
        "vehicleClass": {
          "type": "string"
        },
        "engineCc": {
          "type": "string"
        },
        "engineNumber": {
          "type": "string"
        },
        "chassisNumber": {
          "type": "string"
        },
        "seatingCapacity": {
          "type": "string"
        },
        "tonnage": {
          "type": "string"
        },
        "sumInsured": {
          "type": "number",
          "currency": "KES"
        }
      }
    },
    "client": {
      "path": "draftquote.insurance_data.client",
      "keys": {
        "name": {
          "type": "string",
          "dbPath": "client.name",
          "formLabel": "Insured Name"
        },
        "idNumber": {
          "type": "string",
          "dbPath": "client.id_number",
          "formLabel": "ID Number"
        },
        "gender": {
          "type": "string",
          "dbPath": "client.gender"
        },
        "email": {
          "type": "string",
          "dbPath": "client.email"
        },
        "phone": {
          "type": "string",
          "dbPath": "client.phone"
        }
      }
    },
    "intermediary": {
      "path": "user (via draftquote.draft_quote_user_id)",
      "keys": {
        "name": {
          "type": "string",
          "dbPath": "user.name",
          "formLabel": "Intermediary Name"
        },
        "code": {
          "type": "string",
          "dbPath": "user.cust_code",
          "formLabel": "Intermediary Code"
        },
        "email": {
          "type": "string",
          "dbPath": "user.email"
        },
        "phone": {
          "type": "string",
          "dbPath": "user.phone"
        }
      }
    }
  },
